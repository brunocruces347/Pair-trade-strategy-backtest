# Copia este archivo a .env y ajusta los valores -- .env NO se sube
# al repo (está en .gitignore), esta plantilla sí.

# Ruta a la DB liviana de universo (tickers + fechas de cambios del
# S&P 500 -- generada por universo_historico.guardar_universo_en_db,
# no contiene precios, pesa poco).
UNIVERSO_DB_PATH=universo_sp500.db

# Ticker del ETF usado como proxy de tasa libre de riesgo para el
# CAPM (ej. BIL = SPDR Bloomberg 1-3 Month T-Bill). Ajusta al que uses vos.
TICKER_RF=BIL
